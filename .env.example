APP_NAME=ai-social-media-content-planner
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/ai_social_media_content_planner
DB_USER=ai_social_media_user
DB_PASSWORD=change-this-password
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_VALIDATE_ON_MIGRATE=true

SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_ENABLED=true
SHOW_ACTUATOR_IN_SWAGGER=true
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus

CREDENTIAL_ENCRYPTION_KEY=

AI_PROVIDER_MODE=mock
GENERATION_MAX_CONTENTS_PER_BATCH=50
GENERATION_MAX_IMAGES_PER_BATCH=50
GENERATION_MAX_VIDEOS_PER_BATCH=10
GENERATION_MAX_ESTIMATED_COST_USD=15.00
GENERATION_ESTIMATED_INPUT_TOKENS_PER_ITEM=2000
GENERATION_ESTIMATED_OUTPUT_TOKENS_PER_ITEM=300
GENERATION_FALLBACK_TEXT_INPUT_USD_PER_MILLION_TOKENS=3.00
GENERATION_FALLBACK_TEXT_OUTPUT_USD_PER_MILLION_TOKENS=15.00
GENERATION_ESTIMATED_IMAGE_COST_USD=0.10
GENERATION_ESTIMATED_VIDEO_COST_USD=1.00
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_FILE_SIZE=20MB
UPLOAD_MAX_REQUEST_SIZE=100MB
LINK_EXTRACTION_TIMEOUT=15s
LINK_EXTRACTION_MAX_BODY_SIZE=2097152

ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_BASE_URL=
QWEN_MEDIA_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

MODELS_DEV_API_URL=https://models.dev/api.json
MODELS_DEV_CONNECT_TIMEOUT=5s
MODELS_DEV_READ_TIMEOUT=30s
MODELS_DEV_SYNC_CRON=0 0 3 * * *
MODELS_DEV_SYNC_ZONE=Europe/Istanbul

PUBLISHING_MODE=mock
PUBLISHING_CONNECT_TIMEOUT=5s
PUBLISHING_READ_TIMEOUT=60s
PUBLISHING_MAX_MEDIA_BYTES=536870912
PUBLISHING_MAX_MEDIA_REDIRECTS=5
PUBLISHING_JOB_FIXED_DELAY=30s
PUBLISHING_JOB_MAX_ITEMS_PER_RUN=20

LINKEDIN_BASE_URL=https://api.linkedin.com
LINKEDIN_API_VERSION=202607
LINKEDIN_MEDIA_POLL_INTERVAL=2s
LINKEDIN_MEDIA_POLL_TIMEOUT=2m
LINKEDIN_UPLOAD_CHUNK_SIZE_BYTES=4194304

INSTAGRAM_BASE_URL=https://graph.instagram.com
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_MEDIA_POLL_INTERVAL=60s
INSTAGRAM_MEDIA_POLL_TIMEOUT=5m
INSTAGRAM_UPLOAD_CHUNK_SIZE_BYTES=4194304

TWITTER_BASE_URL=https://api.x.com
TWITTER_API_VERSION=2
TWITTER_MEDIA_POLL_INTERVAL=2s
TWITTER_MEDIA_POLL_TIMEOUT=2m
TWITTER_UPLOAD_CHUNK_SIZE_BYTES=4194304
