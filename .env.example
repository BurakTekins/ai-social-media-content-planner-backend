APP_NAME=ai-social-media-content-planner
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/ai_social_media_content_planner
DB_USER=ai_social_media_user
DB_PASSWORD=change-this-password
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_IDLE_TIMEOUT=300000
DB_CONN_TIMEOUT=30000
DB_MAX_LIFETIME=1800000
DB_VALIDATION_TIMEOUT=5000
DB_LEAK_DETECTION=60000
DB_POOL_NAME=SocialMediaPlannerPool
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_VALIDATE_ON_MIGRATE=true

SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_ENABLED=true
SHOW_ACTUATOR_IN_SWAGGER=true
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus

CREDENTIAL_ENCRYPTION_KEY=

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8080/api/integrations/x/callback
X_FRONTEND_REDIRECT_URI=http://127.0.0.1:5173/#/credentials
X_AUTHORIZATION_URI=https://x.com/i/oauth2/authorize
X_TOKEN_URI=https://api.x.com/2/oauth2/token
X_USER_INFO_URI=https://api.x.com/2/users/me?user.fields=id,name,username
X_SCOPES=tweet.read users.read tweet.write media.write offline.access
X_OAUTH_STATE_TTL=10m
X_OAUTH_CONNECT_TIMEOUT=5s
X_OAUTH_READ_TIMEOUT=30s

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8080/api/integrations/linkedin/callback
LINKEDIN_FRONTEND_REDIRECT_URI=http://127.0.0.1:5173/#/credentials
LINKEDIN_AUTHORIZATION_URI=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URI=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_USER_INFO_URI=https://api.linkedin.com/v2/userinfo
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_OAUTH_STATE_TTL=10m
LINKEDIN_OAUTH_CONNECT_TIMEOUT=5s
LINKEDIN_OAUTH_READ_TIMEOUT=30s

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8080/api/integrations/instagram/callback
INSTAGRAM_FRONTEND_REDIRECT_URI=http://127.0.0.1:5173/#/credentials
INSTAGRAM_AUTHORIZATION_URI=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URI=https://api.instagram.com/oauth/access_token
INSTAGRAM_LONG_LIVED_TOKEN_URI=https://graph.instagram.com/access_token
INSTAGRAM_REFRESH_TOKEN_URI=https://graph.instagram.com/refresh_access_token
INSTAGRAM_USER_INFO_URI=https://graph.instagram.com/v26.0/me?fields=id,user_id,username,name,account_type
INSTAGRAM_SCOPES=instagram_business_basic instagram_business_content_publish
INSTAGRAM_OAUTH_STATE_TTL=10m
INSTAGRAM_OAUTH_CONNECT_TIMEOUT=5s
INSTAGRAM_OAUTH_READ_TIMEOUT=30s

SOCIAL_TOKEN_REFRESH_ENABLED=true
SOCIAL_TOKEN_REFRESH_FIXED_DELAY=1h
SOCIAL_TOKEN_REFRESH_SKEW=5m
INSTAGRAM_TOKEN_REFRESH_BEFORE=7d

AI_PROVIDER_MODE=mock
GENERATION_MAX_CONTENTS_PER_BATCH=50
GENERATION_MAX_IMAGES_PER_BATCH=50
GENERATION_MAX_VIDEOS_PER_BATCH=10
GENERATION_MAX_ESTIMATED_COST_USD=15.00
GENERATION_ESTIMATED_INPUT_TOKENS_PER_ITEM=2000
GENERATION_ESTIMATED_OUTPUT_TOKENS_PER_ITEM=300
GENERATION_ESTIMATED_MEDIA_INPUT_TOKENS_PER_ITEM=500
GENERATION_ESTIMATED_IMAGE_OUTPUT_TOKENS_PER_ITEM=1290
GENERATION_FALLBACK_TEXT_INPUT_USD_PER_MILLION_TOKENS=3.00
GENERATION_FALLBACK_TEXT_OUTPUT_USD_PER_MILLION_TOKENS=15.00
GENERATION_ESTIMATED_IMAGE_COST_USD=0.10
GENERATION_ESTIMATED_VIDEO_COST_USD=1.00
GENERATION_CNY_TO_USD_RATE=0.14
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=60s
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_FILE_SIZE=20MB
UPLOAD_MAX_REQUEST_SIZE=100MB
LINK_EXTRACTION_TIMEOUT=15s
LINK_EXTRACTION_MAX_BODY_SIZE=2097152

