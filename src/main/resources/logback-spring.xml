<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="unknown-service"/>

    <springProfile name="local">
        <appender name="LOCAL_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%15.15thread]){faint} %clr(%-40.40logger{39}){cyan} : %msg%replace( | %mdc){' \| $',''}%n%wEx</pattern>
            </encoder>
        </appender>

        <appender name="ASYNC_LOCAL_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <neverBlock>true</neverBlock>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="LOCAL_CONSOLE"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_LOCAL_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!local">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
                <customFields>{"service":"${serviceName}"}</customFields>
                <includeContext>false</includeContext>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
                <includeMdcKeyName>batchId</includeMdcKeyName>
                <includeMdcKeyName>jobName</includeMdcKeyName>
                <includeMdcKeyName>provider</includeMdcKeyName>
            </encoder>
        </appender>

        <appender name="ASYNC_JSON_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <neverBlock>true</neverBlock>
            <includeCallerData>false</includeCallerData>
            <appender-ref ref="JSON_CONSOLE"/>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_JSON_CONSOLE"/>
        </root>
    </springProfile>

    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="com.globalcodelabs.socialmediaplanner" level="INFO"/>

</configuration>
